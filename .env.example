# ==============================================================================
# Hyperliquid AI Trading Bot - Environment Configuration
# ==============================================================================

# Network selection: true for Testnet (https://api.hyperliquid-testnet.xyz), false for Mainnet
BOTSETTINGS__HYPERLIQUID__USETESTNET=true

# Ethereum Private Key (hex with or without 0x) of master wallet or approved Agent Wallet
# REQUIRED for live order placement. Keep strictly confidential!
BOTSETTINGS__HYPERLIQUID__PRIVATEKEY=0x0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Ethereum Public Wallet Address (or Agent Wallet address)
BOTSETTINGS__HYPERLIQUID__WALLETADDRESS=0x0000000000000000000000000000000000000000

# Optional: Vault contract address if trading on behalf of a vault (leave empty for personal account)
BOTSETTINGS__HYPERLIQUID__VAULTADDRESS=

# Target Perpetual Asset symbol (e.g. BTC, ETH, SOL)
BOTSETTINGS__HYPERLIQUID__ASSET=BTC

# Candle interval for technical analysis: 1m, 5m, 15m, 1h, 4h, 1d
BOTSETTINGS__HYPERLIQUID__CANDLEINTERVAL=1h

# Number of historical candles to analyze (min 20 for RSI/MACD, 50 for SMA50, 200 for SMA200)
BOTSETTINGS__HYPERLIQUID__CANDLELIMIT=100

# Worker polling interval in seconds
BOTSETTINGS__HYPERLIQUID__POLLINTERVALSECONDS=60

# Default Time-In-Force: Gtc (Good-Til-Cancelled), Ioc (Immediate-Or-Cancel), Alo (Post-Only)
BOTSETTINGS__HYPERLIQUID__DEFAULTTIF=Gtc

# ==============================================================================
# AI Quantitative Research Engine Configuration (Google Gemini & OpenAI)
# ==============================================================================
# Model provider: "Gemini" (default) or "OpenAI"
BOTSETTINGS__LLM__PROVIDER=Gemini

# API Key for Google Gemini (obtain from Google AI Studio: https://aistudio.google.com/)
# Set this in your VPS environment, Docker .env, or SmarterASP.NET Application Settings
BOTSETTINGS__LLM__APIKEY=AIzaSy_your_gemini_api_key_here

# Model name: gemini-2.5-flash, gemini-2.5-pro, gemini-1.5-flash, gemini-1.5-pro
BOTSETTINGS__LLM__MODEL=gemini-2.5-flash
BOTSETTINGS__LLM__TEMPERATURE=0.2
BOTSETTINGS__LLM__TIMEOUTSECONDS=30

# Optional: OpenAI settings (if BOTSETTINGS__LLM__PROVIDER is set to OpenAI)
# BOTSETTINGS__OPENAI__APIKEY=sk-proj-your-openai-api-key-here
# BOTSETTINGS__OPENAI__MODEL=gpt-4o
# BOTSETTINGS__OPENAI__TEMPERATURE=0.2
# BOTSETTINGS__OPENAI__TIMEOUTSECONDS=30

# ==============================================================================
# Deterministic Risk Rules & Guardrails
# ==============================================================================
# Minimum AI confidence required to execute trade [0.0 - 1.0]
BOTSETTINGS__RISK__MINCONFIDENCETHRESHOLD=0.75

# Maximum portfolio allocation percentage per position (0.02 = 2%)
BOTSETTINGS__RISK__MAXPORTFOLIOALLOCATIONPCT=0.02

# Hardcoded Stop-Loss range boundaries (1.0% to 5.0%)
BOTSETTINGS__RISK__MINSTOPLOSSPCT=0.01
BOTSETTINGS__RISK__MAXSTOPLOSSPCT=0.05
BOTSETTINGS__RISK__DEFAULTSTOPLOSSPCT=0.02
BOTSETTINGS__RISK__DEFAULTTAKEPROFITPCT=0.04

# Maximum daily account drawdown before trading is frozen (0.05 = 5%)
BOTSETTINGS__RISK__MAXDAILYDRAWDOWNPCT=0.05

# Minimum notional order value in USD mandated by Hyperliquid ($10)
BOTSETTINGS__RISK__MINORDERVALUEUSD=10.0

# ==============================================================================
# Execution Mode
# ==============================================================================
# When true, simulates orders without sending transactions to exchange
BOTSETTINGS__EXECUTION__DRYRUN=true
BOTSETTINGS__EXECUTION__HEARTBEATFILEPATH=/tmp/hyperliquid_bot_heartbeat
